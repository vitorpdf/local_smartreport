{{! SmartReport sprint 1: all URLs and text are escaped by Mustache. }}
<section class="smartreport {{#ishome}}smartreport-home{{/ishome}}">
    {{#ishome}}
    <h2>{{chatname}}</h2>
    <p role="status">{{#str}}success, local_smartreport{{/str}}</p>
    <p class="smartreport-muted">{{#str}}subtitle, local_smartreport{{/str}}</p>
    <div class="smartreport-cards">
        {{#cards}}
        <a class="smartreport-card" href="{{url}}">
            <span class="smartreport-icon" aria-hidden="true">
                <img src="{{circle}}" alt="" width="48" height="48">
                {{#isnew}}<span class="smartreport-plus"><img src="{{plus_h}}" alt="" width="20" height="2"><img src="{{plus_v}}" alt="" width="2" height="20"></span>{{/isnew}}
                {{#ispopular}}<span class="smartreport-list">
                    <img class="sr-dot sr-row1" src="{{list_dot}}" alt="" width="3" height="3">
                    <img class="sr-line sr-row1" src="{{list_line}}" alt="" width="16" height="2">
                    <img class="sr-dot sr-row2" src="{{list_dot}}" alt="" width="3" height="3">
                    <img class="sr-line sr-row2" src="{{list_line}}" alt="" width="16" height="2">
                    <img class="sr-dot sr-row3" src="{{list_dot}}" alt="" width="3" height="3">
                    <img class="sr-line sr-row3" src="{{list_line}}" alt="" width="16" height="2">
                </span>{{/ispopular}}
                {{#isterms}}<span class="smartreport-question">?</span>{{/isterms}}
            </span>
            <h3>{{title}}</h3><p>{{description}}</p><span class="smartreport-arrow" aria-hidden="true">→</span>
        </a>
        {{/cards}}
    </div>
    <p class="smartreport-settings"><a href="{{settings}}">{{#str}}settings, local_smartreport{{/str}}</a></p>
    {{/ishome}}
    {{^ishome}}
    <a href="{{home}}">{{#str}}back, local_smartreport{{/str}}</a>
    <h2>{{title}}</h2><div class="smartreport-body">{{body}}</div>
    {{/ishome}}
</section>
